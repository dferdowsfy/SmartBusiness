# SmartPR frontend environment variables (copy to .env.local and fill in).

# --- Supabase auth (client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (server) ---
# Pooled connection preferred; DIRECT_URL used as a fallback.
DATABASE_URL=
DIRECT_URL=

# --- Requirement monitoring/discovery admin gate ---
# Comma-separated allowlist of admin emails who can see the "Admin" entry point
# and run discovery/monitoring or approve requirements.
# OPEN DEFAULT: if unset/empty, ANY signed-in user is treated as an admin. Set
# this to lock access down to specific accounts.
ADMIN_EMAILS=

# Shared secret for the cron-compatible monitoring endpoint
# (POST/GET /api/requirements/monitor with header `x-cron-secret: <value>`).
REQUIREMENT_MONITOR_CRON_SECRET=
