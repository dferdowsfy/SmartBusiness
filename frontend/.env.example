# SmartPR frontend environment variables (copy to .env.local and fill in).

# --- Supabase auth (client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (server) ---
# Pooled connection preferred; DIRECT_URL used as a fallback.
DATABASE_URL=
DIRECT_URL=

# --- Requirement monitoring/discovery admin gate ---
# Comma-separated allowlist of admin emails. ONLY these signed-in users see the
# "Admin" entry point and can run discovery/monitoring or approve requirements.
# If unset, NOBODY is an admin (safe default).
ADMIN_EMAILS=dferdows@gmail.com

# Shared secret for the cron-compatible monitoring endpoint
# (POST/GET /api/requirements/monitor with header `x-cron-secret: <value>`).
REQUIREMENT_MONITOR_CRON_SECRET=
