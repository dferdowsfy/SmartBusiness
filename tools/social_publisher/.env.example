# Copy this file to .env (same folder) and fill in the values below.
# .env is git-ignored; never commit real credentials.
# Full setup walkthrough for each platform: see README.md.

# --- YouTube (Google Cloud / YouTube Data API v3) ---
# 1. console.cloud.google.com -> new project -> enable "YouTube Data API v3".
# 2. OAuth consent screen: "External", add yourself as a test user (Testing
#    mode is enough for personal/manual use - no Google review needed).
# 3. Credentials -> Create OAuth client ID -> Application type "Desktop app"
#    -> download the JSON file. Do NOT commit it; keep it outside git or
#    somewhere already git-ignored.
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json

# --- TikTok (TikTok for Developers, Content Posting API) ---
# 1. developers.tiktok.com/apps -> create an app -> add the "Content Posting
#    API" product with the video.publish and video.upload scopes.
# 2. Add the redirect URI below (exactly) under Login Kit; TikTok may
#    require verifying the redirect domain for anything other than
#    localhost.
# 3. Until TikTok audits your app, all posts publish as SELF_ONLY (private).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8722/callback

# --- Instagram (Instagram API with Instagram Login) ---
# 1. developers.facebook.com/apps -> create an app -> add the "Instagram"
#    product configured for "Business Login for Instagram" (Instagram API
#    with Instagram Login) - this does NOT require a linked Facebook Page.
# 2. Your Instagram account must be a Business or Creator account (not
#    Personal). Add yourself as a tester/admin on the app so you can log
#    in before the app has gone through App Review.
# 3. Add the redirect URI below under the Instagram product's OAuth
#    settings.
# 4. IG_USER_ID is auto-discovered from your login on first run; only set
#    it if you need to override that (e.g. posting as a different account
#    than the one you authorize with).
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8723/callback
IG_USER_ID=
